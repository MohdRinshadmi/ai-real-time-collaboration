{
  "name": "@collab/api",
  "version": "0.1.0",
  "private": true,
  "description": "Collab REST API — Express MVC backend",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon --exec babel-node bin/www",
    "build": "babel . --out-dir dist --copy-files --ignore \"node_modules/**\",\"dist/**\",\"logs/**\",\"uploads/**\",\"**/*.test.js\"",
    "start": "node bin/www",
    "start:prod": "pm2 start pm2_config.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo logs/*.log"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.23.7",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@opentelemetry/sdk-node": "^0.51.0",
    "@prisma/client": "^5.13.0",
    "argon2": "^0.40.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/node": "^7.23.9",
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "vitest": "^1.4.0"
  }
}
