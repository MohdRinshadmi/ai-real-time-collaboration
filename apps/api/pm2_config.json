{
  "apps": [
    {
      "name": "collab-api",
      "script": "bin/www",
      "node_args": "-r @babel/register",
      "instances": "max",
      "exec_mode": "cluster",
      "watch": false,
      "max_memory_restart": "512M",
      "env": {
        "NODE_ENV": "development",
        "PORT": 4000
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 4000
      },
      "error_file": "logs/pm2-error.log",
      "out_file": "logs/pm2-out.log",
      "merge_logs": true,
      "time": true
    }
  ]
}
