# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database (Postgres / Prisma) ----
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab?schema=public
# Optional read replica
# DATABASE_URL_REPLICA=

# ---- Redis ----
REDIS_URL=redis://localhost:6379
# REDIS_PUBSUB_URL=

# ---- Auth / JWT (secrets must be >= 32 chars) ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Object storage (S3) ----
S3_REGION=us-east-1
S3_BUCKET=collab-uploads

# ---- Messaging / CORS ----
KAFKA_BROKERS=
CORS_ORIGINS=http://localhost:3000
