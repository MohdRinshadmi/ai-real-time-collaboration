{
  "extends": "../../packages/config/tsconfig-react.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    // Override the shared config's `rootDir: "src"` (which resolves to
    // packages/config/src and rejects every app file). The app root contains
    // src, next-env.d.ts, and .next/types.
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
