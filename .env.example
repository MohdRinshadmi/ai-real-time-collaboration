# ─── Core ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab?schema=public
DATABASE_URL_REPLICA=postgresql://collab:collab@localhost:5432/collab?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PUBSUB_URL=redis://localhost:6379/1

# ─── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-prod-use-rs256-keypair
JWT_REFRESH_SECRET=change-me-in-prod-use-rs256-keypair
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Storage (S3) ────────────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=collab-files-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_CDN=https://cdn.example.com

# ─── Email ───────────────────────────────────────────────────
SES_REGION=us-east-1
EMAIL_FROM=noreply@collab.example.com

# ─── URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_AI_URL=http://localhost:4002

# ─── Observability ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
PROMETHEUS_PORT=9464

# ─── Feature Flags ───────────────────────────────────────────
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=
